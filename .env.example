# SecondHandler – environment overrides
#
# EVERY variable in this file is OPTIONAL. compose expects a .env file, but it may be empty.
# Setup happens in the dashboard (Settings):
#   - Claude:          "Sign in with Claude" (token is stored in data/claude-token)
#   - Home Assistant:  connect via OAuth (token is stored in data/ha-token), pick the push target there
#   - willhaben:       Settings -> willhaben account -> log in via the remote browser view
#
# Only set a variable here if you want to override the default or the value from the dashboard.
# Copy to .env and uncomment what you need. Never commit .env.

# ===========================================================================
# Recommended
# ===========================================================================

# Password for the dashboard (login page) and API (HTTP Basic auth). Strongly recommended:
# the app can send messages in your name. Without it the dashboard is open to anyone on the network.
DASHBOARD_PASSWORD=
# DASHBOARD_USER=admin

# ===========================================================================
# Web / ports (optional)
# ===========================================================================

# Host port of the dashboard (used by compose)
DASHBOARD_PORT=8000
# URL under which you open the dashboard (links in Telegram / Home Assistant notifications; Telegram buttons need
# https://). Settings → Web address in the dashboard wins over this value.
# PUBLIC_URL=http://homeserver:8000

# ===========================================================================
# Claude (optional – normally done via "Sign in with Claude" in Settings)
# ===========================================================================

# Uses `claude -p` with your Max subscription, no API key. Alternative to the dashboard login:
# run `claude setup-token` once on your PC and paste the token (valid 1 year).
# A token from the dashboard login takes precedence over this one.
# CLAUDE_CODE_OAUTH_TOKEN=
# Default model: opus or sonnet (per-purpose models can be picked in Settings)
# LLM_MODEL=opus
# Do NOT set ANTHROPIC_API_KEY: it would take precedence over the subscription token and bill the API.

# ===========================================================================
# Home Assistant (optional – normally done via "Connect" in Settings)
# ===========================================================================

# HA_URL=https://homeassistant.local:8123
# Long-lived access token (HA profile -> Security); only needed instead of the OAuth connect
# HA_TOKEN=
# Also push via notify.<service>, e.g. mobile_app_pixel_8 (can be picked in Settings)
# HA_NOTIFY_SERVICE=

# ===========================================================================
# Login browser via noVNC (optional, LAN only)
# ===========================================================================

# The remote browser view in the dashboard is enough for the willhaben login; noVNC is an extra.
# noVNC always asks for a password (VNC allows at most 8 characters).
# NOVNC_PORT=6080
# VNC_PASSWORD=          # empty: a random one is generated into data/vnc-password
# NOVNC_URL=http://homeserver:6080/vnc.html?autoconnect=1&resize=scale

# ===========================================================================
# Polling and rate limits (optional; keep them polite – willhaben forbids aggressive automation)
# ===========================================================================

# Minimum gap between any two willhaben requests, in seconds
REQUEST_MIN_GAP_S=3.0
# Hard budget over all willhaben requests per hour (0 = off)
REQUESTS_PER_HOUR=240
# DEFAULT_AGENT_INTERVAL_S=300
# MIN_AGENT_INTERVAL_S=120
# CHAT_POLL_INTERVAL_S=300
# Hour of the daily check of your own ads
# MYADS_CHECK_HOUR=8
# Offline replay: answer willhaben requests from the ones recorded with Settings → Timeline → "Record willhaben
# requests"; unknown requests still go to willhaben. Together with BROWSER_ENABLED=0 nothing logs in.
# WH_REPLAY=1

# ===========================================================================
# Other platforms (search agents on more second-hand sites; switch them on in Settings → Platforms)
# ===========================================================================

# Which adapters exist (comma list); willhaben is always there
# PLATFORMS_ENABLED=willhaben,kleinanzeigen,shpock,vinted,preisjaeger,ebay,facebook

# willhaben's app interface (chats, own ads, searches without the browser): the key willhaben's Android app signs its
# token request with. Not part of SecondHandler. Set here it overrides the field in Settings -> willhaben; without one
# the browser does everything.
# WILLHABEN_APP_KEY=

# kleinanzeigen.de: pacing of its own (the app's API), and the app credentials in case the bundled ones stop working
# PLATFORM_KLEINANZEIGEN_MIN_GAP_S=3.0
# PLATFORM_KLEINANZEIGEN_PER_HOUR=120
# KLEINANZEIGEN_API_AUTH=user:password
# Shpock, Vinted, Preisjäger, eBay: no login; their pacing (seconds between requests, requests per hour)
# PLATFORM_SHPOCK_MIN_GAP_S=4.0
# PLATFORM_SHPOCK_PER_HOUR=90
# PLATFORM_VINTED_MIN_GAP_S=8.0
# PLATFORM_VINTED_PER_HOUR=40
# PLATFORM_PREISJAEGER_MIN_GAP_S=4.0
# PLATFORM_PREISJAEGER_PER_HOUR=60
# PLATFORM_EBAY_MIN_GAP_S=8.0
# PLATFORM_EBAY_PER_HOUR=40
# Facebook Marketplace: logged-out pages only (no account); its terms forbid automated access, so it goes slower
# PLATFORM_FACEBOOK_MIN_GAP_S=8.0
# PLATFORM_FACEBOOK_PER_HOUR=60

# VPN for the anonymous requests: WireGuard configs (a .zip collection or one .conf) are uploaded in Settings → VPN.
# The wireproxy binary is part of the image; only needed outside of it.
# WIREPROXY_BIN=wireproxy

# ===========================================================================
# Networking (optional)
# ===========================================================================

# Map hostnames (space-separated, e.g. your HA hostname) to a reverse-proxy container on a shared
# Docker network, for hosts the container cannot reach otherwise. Usually set in compose.override.yaml.
# PROXY_VIA=
# PROXY_HOSTS=
